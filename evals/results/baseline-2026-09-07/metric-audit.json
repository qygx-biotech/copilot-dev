  "findings": [
    {
      "id": "numeric_zero_is_fulfillment_not_arithmetic_error_rate",
      "severity": "interpretation",
      "evidence": "Eight primary EctD cases / 16 observations: six emitted numeric results, eight unresolved queries, two queries not invoked.",
      "conclusion": "All eight fail exact requested primitive-result fulfillment, but it is false to describe all sixteen observations as wrong computed arithmetic. No generated answer was available to score."
    },
    {
      "id": "numeric_component_matching_understates_metadata",
      "severity": "scorer_defect",
      "cases": [
        "CW-ECTD_EXPERIMENTS-07"
      ],
      "evidence": "Both saved groups have field=titer, unit=g/L, aggregation=mean, groupValue=A163V or T212S. Scorer disambiguation uses gold.filters.batch but gold uses filters.variant; matched=false sets every component false.",
      "conclusion": "Frozen field/unit/aggregation component scores understate matching emitted metadata. Independent group-value comparison still finds 4.75 vs 4.65 and 4.075 vs 3.95; exact0 remains supported. No rescore or baseline rewrite performed."
    },
    {
      "id": "stress_fields_and_primary_schema_failures_are_distinct",
      "severity": "interpretation",
      "evidence": "Open-domain gold includes modulus_kPa, retention_pct and water_uptake_g_g, outside the fixed production canonical ontology; EctD gold includes titer/yield/productivity, but X02 suffixed raw headers remain unnormalized.",
      "conclusion": "Overall experiment0 cannot be presented as an accuracy estimate for established production scientific fields. Report EctD8 separately. Activity gold naming activity versus specific_activity is an additional schema-convention mismatch; observed wrong titer selection and unresolved output remain independently visible."
    },
    {
      "id": "corpus_recall_is_relevant_subset_not_snapshot_coverage",
      "severity": "denominator",
      "evidence": "Saved corpus.analyzedRecall=.944444 uses 3 valid case clusters and relevant gold paper subsets. All four observed workflows have 7/8 analyzed cold and 8/8 warm; one workflow is blocked because requested fault injection was unreached.",
      "conclusion": "Use raw cold87.5%/warm100% snapshot coverage for execution completeness. Corpus status completed can coexist with a failed source. Do not generalize three scored cases to all corpus requests."
    },
    {
      "id": "actual_corpus_path_in_ranked_retrieval_cohort",
      "severity": "scope",
      "cases": [
        "CW-DISCOVERY-05"
      ],
      "evidence": "Static category discovery keeps this case in retrieval metrics despite actual.corpusWorkflow being present.",
      "conclusion": "Frozen retrieval metric mixes one corpus-routed discovery case into ordinary discovery. Supplemental same-observation metrics excluding every actual corpus workflow are supplied separately."
    },
    {
      "id": "evidence_prefix_is_not_independently_ranked_chunk_retrieval",
      "severity": "interpretation",
      "evidence": "Original adapter forms evidenceIds by deduplicating readPaperEvidence page aliases followed by citationEvidence and memory aliases.",
      "conclusion": "Evidence Recall@K/MRR describe emitted evidence order. They do not establish an independently relevance-ranked chunk retriever, evidence entailment, or final citation correctness."
    },
    {
      "id": "bilingual_sample_size_is_three_pairs",
      "severity": "uncertainty",
      "evidence": "Six matched pair observations are the same three EN/ZH pairs in cold and warm conditions; one stochastic repeat only.",
      "conclusion": "Paper/evidence recall EN1 vs ZH2/3 and gap1/3 are correct for these pairs. They are not a broad language-quality estimate; fixed-seed gap CI [0,1] reflects the small case set. Cold/warm are not independent model trials."
    },
    {
      "id": "located_evidence_does_not_prove_entailment",
      "severity": "interpretation",
      "evidence": "Corpus verification statuses are exclusively original-evidence-located. Controlled cards copy fixture excerpts; final answer count0.",
      "conclusion": "Do not convert located-evidence counts to semantic support, factual answer accuracy, or judge win rates."
    },
    {
      "id": "sync_success_cohort_has_setup_limitations",
      "severity": "harness",
      "cases": [
        "CW-SYNC_FAILURE-02",
        "CW-SYNC_FAILURE-08",
        "CW-ECTD_WORKFLOWS-05"
      ],
      "evidence": "Post-baseline adapter audit says newly added P83 was already in initial fixture; explicit sync mutation unsupported. Failed-but-now-readable P131 case kept the failure state; verified bytes can be current while artifacts fail.",
      "conclusion": "Frozen version/freshness1 must not imply comprehensive sync acceptance. Corrected adapter replays are separate evidence, not baseline improvements."
    },
    {
      "id": "cost_latency_and_context_are_local_boundary_measurements",
      "severity": "interpretation",
      "evidence": "No live FC calls or generated answers; all USD role values null. mainContextCharacters is JSON.stringify(context).length, and preflight/mainGate are final context-turn telemetry.",
      "conclusion": "Logical cards/QMD updates are not provider billing; latency is not end-to-end streamed-answer latency; serialized characters are not model tokens or proof of actual prompt size. Maintenance transcript presence is unmeasured."
    },
    {
      "id": "blocked_cases_and_missing_audits_are_not_permission_failures",
      "severity": "scope",
      "evidence": "26 observations are blocked/error; complete permission, final citation, and action audits are absent. Adversarial review separates native-project-scope setup mismatches.",
      "conclusion": "Retain hard-gate failures and unknowns individually. Do not count unexecuted setup, missing final answer, or incomplete access audit as demonstrated production permission violations."
    }
