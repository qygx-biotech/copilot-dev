REQUESTY_API_KEY=your_requesty_api_key_here
REQUESTY_MODEL=your_requesty_model_here
# Optional vision-capable model for Side Chat images; defaults to REQUESTY_MODEL.
REQUESTY_IMAGE_MODEL=
# Optional cloud-retrieval overrides. Each falls back to REQUESTY_MODEL.
REQUESTY_SEARCH_PLANNER_MODEL=
REQUESTY_RERANK_MODEL=
# Optional capability-specific model. OpenAI PDF models are selected with the
# openai-responses/ prefix without changing REQUESTY_MODEL.
REQUESTY_PDF_MODEL=
REQUESTY_PDF_ENABLED=true
# Conservative default: native PDF and strict schema are split into two calls.
REQUESTY_PDF_SUPPORTS_JSON_SCHEMA=false
# Enable after confirming supports_json_schema in Requesty's model catalog.
# False or unset uses json_object with the complete schema and local validation.
REQUESTY_MODEL_SUPPORTS_JSON_SCHEMA=false
# Optional per-model overrides, for example:
# {"anthropic/model":{"pdf":true,"jsonSchema":true,"pdfJsonSchema":true}}
REQUESTY_MODEL_CAPABILITIES_JSON=
OSS_BUCKET=biodesign-copilot-files-2026
OSS_REGION=oss-cn-beijing
OSS_INTERNAL_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
OSS_PUBLIC_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
