REQUESTY_API_KEY=your_admin_requesty_api_key_here
# Existing admin login and shared session signing secret (FC only).
ADMIN_ACCOUNT=your_admin_account
ADMIN_PASSWORD_HASH=your_existing_bcrypt_hash
JWT_SECRET=your_existing_jwt_secret
# Optional beta login configuration. Omit this variable or use [] for admin only.
# In the FC console paste the JSON itself, without surrounding shell quotes.
BETA_USERS_JSON=[]
# Example row (all five fields required; the hash placeholder must be replaced):
# [{"id":"beta01","account":"example-user","passwordHash":"<bcrypt hash>","requestyKeyEnv":"REQUESTY_KEY_BETA01","active":true}]
# Store each real key only in its own FC environment variable/secret.
# REQUESTY_KEY_BETA01=the_requesty_key_belonging_to_beta01
# REQUESTY_KEY_BETA02=the_requesty_key_belonging_to_beta02
# Default model. The Side Chat Nemotron option is allowlisted in backend code;
# it uses the authenticated user's key and does not change the global default.
REQUESTY_MODEL=your_requesty_model_here
# Vision model for clients without a Side Chat selection; defaults to REQUESTY_MODEL.
# A selected Side Chat model overrides this and the other role models for that turn.
REQUESTY_IMAGE_MODEL=
# Optional cloud-retrieval overrides. Each falls back to REQUESTY_MODEL.
REQUESTY_SEARCH_PLANNER_MODEL=
REQUESTY_RERANK_MODEL=
# Optional capability-specific model. OpenAI PDF models are selected with the
# openai-responses/ prefix without changing REQUESTY_MODEL.
REQUESTY_PDF_MODEL=
REQUESTY_PDF_ENABLED=true
# Conservative default: native PDF and strict schema are split into two calls.
REQUESTY_PDF_SUPPORTS_JSON_SCHEMA=false
# Enable after confirming supports_json_schema in Requesty's model catalog.
# False or unset uses json_object with the complete schema and local validation.
REQUESTY_MODEL_SUPPORTS_JSON_SCHEMA=false
# Optional per-model overrides, for example:
# {"anthropic/model":{"pdf":true,"jsonSchema":true,"pdfJsonSchema":true}}
REQUESTY_MODEL_CAPABILITIES_JSON=
OSS_BUCKET=biodesign-copilot-files-2026
OSS_REGION=oss-cn-beijing
OSS_INTERNAL_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
OSS_PUBLIC_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
